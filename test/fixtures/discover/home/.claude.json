{
  "numStartups": 12,
  "theme": "dark",
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "docs-search": {
      "type": "http",
      "url": "https://mcp.example.invalid/mcp"
    }
  },
  "projects": {
    "/home/dev/app": {
      "allowedTools": [],
      "mcpServers": {
        "sqlite": {
          "type": "stdio",
          "command": "uvx",
          "args": [
            "mcp-server-sqlite",
            "--db-path",
            "/home/dev/app/data.db"
          ],
          "env": {}
        }
      },
      "hasTrustDialogAccepted": true
    },
    "/home/dev/empty": {
      "mcpServers": {}
    }
  }
}
